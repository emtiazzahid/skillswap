// Read ONLY by @sveltejs/adapter-cloudflare at build time (see vite.config.ts).
// The adapter writes its bundle to `main`, so this must never point at src/worker.ts.
// Runtime config for wrangler dev/deploy lives in wrangler.jsonc.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skillswap",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" }
}
