{
	"name": "skillswap",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Neighbors trade skills, no money. A community noticeboard for swapping what you know.",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply skillswap-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply skillswap-db --remote",
		"deploy": "pnpm build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"mockups:render": "node scripts/render-mockups.ts",
		"assets:render": "node scripts/render-assets.ts",
		"seed:local": "tsx scripts/seed.ts",
		"social:kit": "tsx scripts/social-kit.ts",
		"logo:kit": "tsx scripts/logo-kit.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260905.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.0",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.2.0",
		"@fontsource-variable/public-sans": "^5.2.0",
		"@fontsource/caveat": "^5.2.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
